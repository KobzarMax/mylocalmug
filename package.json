  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test:content": "tsx scripts/content-validation.test.ts && tsx scripts/push-delivery.test.ts",
    "test:offline": "tsx scripts/offline-cache.test.ts",
    "test:legal": "tsx scripts/legal-validation.test.ts",
    "test:menu": "jest --runInBand src/features/menu",
    "test:payments": "tsx scripts/payment-validation.test.ts",
    "test:rewards": "tsx scripts/reward-validation.test.ts",
    "test:ui": "jest --runInBand",
    "test": "pnpm run test:content && pnpm run test:offline && pnpm run test:legal && pnpm run test:menu && pnpm run test:payments && pnpm run test:rewards && pnpm run test:ui",
    "lint": "expo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.test.ts?(x)"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/supabase/"
    ]
  },
  "private": true
